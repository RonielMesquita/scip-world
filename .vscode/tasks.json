{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 SCIP Dev",
      "type": "shell",
      "command": "npx expo start --web --port 8081",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "label": "SCIP Dev Server"
      },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "(Bundling complete|webpack compiled|Ready)"
        }
      }
    }
  ]
}
